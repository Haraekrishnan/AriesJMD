{
  "rules": {
    "privateRecruitment": {
      "presence": {
        ".read": true,
        "$session": {
          ".write": true,
          ".validate": "newData.hasChildren(['userId','name','candidateId','field','at']) && newData.child('userId').isString() && newData.child('name').isString() && newData.child('candidateId').isString() && newData.child('field').isString() && newData.child('at').isNumber()"
        }
      },
      "layout": {
        ".read": true,
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['revision','updatedBy','updatedByName','updatedAt']) && newData.child('revision').isNumber() && newData.child('revision').val() === (data.exists() ? data.child('revision').val() + 1 : 1) && newData.child('updatedBy').isString() && newData.child('updatedByName').isString() && newData.child('updatedAt').isString()",
        "extraColumns": {
          "$index": {
            ".validate": "newData.isString() && (newData.val() === 'age' || newData.val() === 'experience' || newData.val() === 'salary' || newData.val() === 'allowance' || newData.val() === 'remark' || newData.val() === 'followUp' || newData.val() === 'followUpChannel' || newData.val() === 'status' || newData.val() === 'travelDate' || newData.val() === 'travelNote' || newData.val().matches(/^custom_[A-Za-z0-9_-]+$/))"
          }
        }
      },
      ".read": false,
      ".write": false,
      "records": {
        ".read": true,
        "$id": {
          ".write": "newData.exists()",
          ".validate": "newData.hasChildren(['id', 'values', 'revision', 'createdBy', 'createdByName', 'createdAt', 'updatedBy', 'updatedByName', 'updatedAt', 'history']) && newData.child('id').val() === $id && newData.child('values/name').isString() && newData.child('values/name').val().length > 0 && newData.child('revision').isNumber() && (newData.child('deletedAt').exists() || newData.child('values/stage').val() === 'On Going' || newData.child('values/stage').val() === 'Finalized' || newData.child('values/stage').val() === 'Not Interested' || (root.child('privateRecruitment/layout/sheets').child(newData.child('values/stage').val()).exists() && root.child('privateRecruitment/layout/sheets').child(newData.child('values/stage').val()).child('deleted').val() !== true && root.child('privateRecruitment/layout/sheets').child(newData.child('values/stage').val()).child('deleting').val() !== true))"
        }
      }
    },
    ".read": false,
    ".write": false,
    "users": {
      ".read": true,
      ".indexOn": "email",
      "$uid": {
        ".write": true
      }
    },
